COMPLIANCE_EXPORT_RETENTION_DAYS=90

# ─── Soroban TTL Renewal Bot ───────────────────────────────────────────────────
# Background worker that checks configured Soroban contract instance storage
# TTL and submits an ExtendFootprintTTL bump before it expires. Uses
# NEXT_PUBLIC_SOROBAN_RPC_URL / NEXT_PUBLIC_NETWORK_PASSPHRASE for RPC config.
# Secret key of the account that pays for and signs renewal transactions.
# Required — the bot skips its check (and logs an error) if this is unset.
TTL_RENEWAL_SIGNER_SECRET=
# Comma-separated list of Soroban contract IDs to monitor (no spaces needed).
TTL_RENEWAL_CONTRACT_IDS=
# Renew when the contract's remaining TTL falls below this many ledgers.
# Default: 17280 (~1 day at 5s/ledger).
TTL_RENEWAL_THRESHOLD_LEDGERS=17280
# Ledger count to extend the TTL to when a renewal is triggered.
# Default: 518400 (~30 days at 5s/ledger).
TTL_RENEWAL_EXTEND_TO_LEDGERS=518400
# How often the worker re-checks all configured contracts (ms).
# Default: 3600000 (1 hour).
TTL_RENEWAL_POLL_INTERVAL_MS=3600000

# ─── AWS S3 (private tree photo evidence) ─────────────────────────────────────
# Region for the S3 bucket hosting private tree/planter photo evidence.
AWS_REGION=us-east-1
# Private bucket that stores planting photo evidence. Block Public Access must
# remain enabled at the bucket level. See docs/private-s3-photo-uploads.md.
AWS_S3_BUCKET=private-photo-evidence-bucket
# Optional locally; prefer an IAM runtime role in production (ecs/task role,
# ec2 instance profile, lambda execution role, etc.). Leave blank to use the
# standard AWS credential provider chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of the short-lived pre-signed upload URL. Clamped server-side to
# 60-900 seconds regardless of the configured value. Default: 300.
S3_UPLOAD_URL_EXPIRES_IN_SECONDS=300

# ─── Species Growth Rate Engine ────────────────────────────────────────────────
# Regional rainfall/temperature climatology API used to adjust species growth
# curves. Default (NASA POWER) is free and requires no key. See
# docs/species-growth-engine.md.
CLIMATE_API_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
# Only needed if CLIMATE_API_BASE_URL points at a provider that requires one;
# sent as an "Authorization: Bearer" header. Leave blank for NASA POWER.
CLIMATE_API_KEY=
# Request timeout (ms) before falling back to a climate-neutral curve.
# Default: 8000.
CLIMATE_API_TIMEOUT_MS=8000

# ─── Sentry (server-side error tracking) ──────────────────────────────────────
# Leave SENTRY_DSN blank to disable error tracking entirely — the integration
# no-ops, which is the expected setup for local development and CI.
# Find the DSN under Project Settings → Client Keys (DSN) in Sentry.
SENTRY_DSN=
# Environment name events are tagged with (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=production
# Version events are attributed to, e.g. a git SHA. Optional.
SENTRY_RELEASE=
# Performance-trace sampling, 0..1. Errors are always captured regardless.
# Invalid values fall back to 0.
SENTRY_TRACES_SAMPLE_RATE=0