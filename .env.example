# ─── Network ──────────────────────────────────────────────────────────────────
# Which Stellar network to connect to: "testnet" | "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# ─── RPC / Horizon URLs ───────────────────────────────────────────────────────
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ─── RPC Node Health Monitoring & Fallback ─────────────────────────────────────
# Comma-separated list of Stellar Horizon RPC node URLs for health monitoring.
# The RpcHealthMonitor pings each node and dynamically routes to the fastest
# healthy node. Falls back to NEXT_PUBLIC_HORIZON_URL if unset.
# RPC_NODE_URLS=https://horizon-testnet.stellar.org,https://horizon.stellar.org,https://rpc.myhorizon.io
# Optional comma-separated names for each node (defaults: node-0, node-1, ...)
# RPC_NODE_NAMES=testnet,mainnet,my-horizon
# Optional comma-separated weights (reserved for future use; defaults: 1 each)
# RPC_NODE_WEIGHTS=1,1,1
# Ping timeout per node in milliseconds (default: 5000)
# RPC_PING_TIMEOUT_MS=5000
# Consecutive failures before marking a node unhealthy (default: 3)
# RPC_MAX_CONSECUTIVE_FAILURES=3
# Background worker poll interval in milliseconds (default: 30000)
# RPC_MONITOR_POLL_INTERVAL_MS=30000

# ─── Network Passphrase ───────────────────────────────────────────────────────
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ─── USDC Issuer ──────────────────────────────────────────────────────────────
# Testnet:  GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet:  GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Issuers for the additional stablecoins accepted by escrow. Configure the
# network-specific issuer and add the same token address to the contract
# whitelist during deployment.
NEXT_PUBLIC_USDT_ISSUER=
NEXT_PUBLIC_EURC_ISSUER=

# ─── TREE Token Issuer ────────────────────────────────────────────────────────
# Deployed via scripts/deploy-tree-asset.mjs on Stellar testnet.
# Issuer is locked (master weight = 0) — 1 billion TREE minted to distributor.
# 1 TREE = 1 verified tree planted = 48 kg CO₂ offset over 25-year horizon.
# Full deployment details: docs/tree-token.md
#
# Testnet issuer      : GA5WBQTSUOCBCNI4GNX7RKN75F5RNUR25KJXADQ7VBCKHTKPDVU4R27S
# Testnet distributor : GDB7XVIR7YF5QEPL5N7ZVGBLGETUOTZS46MPM32SYNIWZNYXCKYZDVLG
# Stellar Expert      : https://stellar.expert/explorer/testnet/asset/TREE-GA5WBQTSUOCBCNI4GNX7RKN75F5RNUR25KJXADQ7VBCKHTKPDVU4R27S
NEXT_PUBLIC_TREE_ISSUER=GA5WBQTSUOCBCNI4GNX7RKN75F5RNUR25KJXADQ7VBCKHTKPDVU4R27S
NEXT_PUBLIC_TREE_DISTRIBUTOR=GDB7XVIR7YF5QEPL5N7ZVGBLGETUOTZS46MPM32SYNIWZNYXCKYZDVLG

# ─── Carbon Credit (CARBON) Issuer ───────────────────────────────────────────
NEXT_PUBLIC_CARBON_CREDIT_ISSUER=GDUKMGUGDORQJH6YWY4RHDE6GV3NCYCBN3MORXYL43TSJPCCZFLNOA5H

# ─── Contract IDs (Soroban) ───────────────────────────────────────────────────
NEXT_PUBLIC_CONTRACT_TREE_ESCROW=REPLACE_WITH_TREE_ESCROW_CONTRACT_ID
NEXT_PUBLIC_CONTRACT_ESCROW_MILESTONE=REPLACE_WITH_ESCROW_MILESTONE_CONTRACT_ID
NEXT_PUBLIC_CONTRACT_LOCATION_PROOF=REPLACE_WITH_LOCATION_PROOF_CONTRACT_ID
NEXT_PUBLIC_CONTRACT_NULLIFIER_REGISTRY=REPLACE_WITH_NULLIFIER_REGISTRY_CONTRACT_ID
NEXT_PUBLIC_CONTRACT_CARBON_CREDITS=REPLACE_WITH_CARBON_CREDITS_CONTRACT_ID

# ─── Platform Addresses ───────────────────────────────────────────────────────
# Receives 70% of each donation (direct tree planting)
NEXT_PUBLIC_PLANTING_ADDRESS=GABEMKJNR4GK7M4FROGA7I7PG63N2CKE3EGDSBSISG56SVL2O3KRNDXA
# Receives 30% of each donation (replanting buffer fund)
NEXT_PUBLIC_REPLANTING_BUFFER_ADDRESS=GBUQWP3BOUZX34TOND2QV7QQ7K7VJTG6VSE62MFPXXXIAGKZ6YTDCXI
# Receives bulk purchase payments
NEXT_PUBLIC_BULK_RECIPIENT_ADDRESS=GABEMKJNR4GK7M4FROGA7I7PG63N2CKE3EGDSBSISG56SVL2O3KRNDXA

# ─── Anchor API ───────────────────────────────────────────────────────────────
# SEP-24 / SEP-31 anchor endpoint for on/off-ramp
NEXT_PUBLIC_ANCHOR_API_URL=https://testanchor.stellar.org
# Anchor home domain (used for TOML discovery)
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── SendGrid (email notifications) ──────────────────────────────────────────
# Required for tree milestone email notifications (issue #548)
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
SENDGRID_FROM_EMAIL=no-reply@harvesta.app

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Secret used to sign planter JWTs. Must be at least 32 characters in production.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# ─── Rate Limiting & Security ──────────────────────────────────────────────────
# Comma-separated list of IPs to block at the API gateway (no spaces).
BLOCKED_IPS=

# Comma-separated list of verified partner domains allowing cross-origin requests.
# Supports wildcard subdomains e.g. *.harvesta.app, *.stellar.org, *.farm-credit.org
ALLOWED_ORIGINS=*.harvesta.app,*.stellar.org,*.farm-credit.org,http://localhost:3000
# Enable CORS preflight (OPTIONS) for all whitelisted origins.
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization


# ─── Redis Cache ──────────────────────────────────────────────────────────────
# Optional Redis connection string for shared GPS map query caching.
# Used for distributed locks (Redlock) to prevent Stellar sequence/nonce collisions.
REDIS_URL=

# For Redlock multi-instance: comma-separated Redis URLs (overrides REDIS_URL if set)
# REDIS_URLS=redis://127.0.0.1:6379,redis://127.0.0.1:6380,redis://127.0.0.1:6381

# ─── Redis Redlock (Wallet Transaction Serialization) ─────────────────────────
# Prevents nonce/sequence collisions by serializing wallet transaction signing
# requests via Redis Redlock distributed locks.
# See lib/cache/redlock.ts for implementation.
REDIS_LOCK_TTL_MS=10000
REDIS_LOCK_RETRY_COUNT=10
REDIS_LOCK_RETRY_DELAY_MS=100
REDIS_LOCK_RETRY_JITTER_MS=100
REDIS_LOCK_SIGNING_TTL_MS=30000
REDIS_LOCK_SIGNING_RETRY=20

# TTL (seconds) for cached GET /api/planting/map responses. Falls back to 300
# when unset or not a positive integer.
GPS_MAP_CACHE_TTL_SECONDS=300


# ─── Event Indexer ────────────────────────────────────────────────────────────
# Comma-separated Soroban contract IDs to watch for TreeMinted, ProgressSubmitted,
# and FundsReleased events. Leave blank to index all contracts.
TREE_CONTRACT_IDS=

# ─── Treasury Monitor ──────────────────────────────────────────────────────────
# Background worker that polls Horizon for USDC balances on treasury addresses
# and sends email alerts when balances drop below the threshold.
TREASURY_USDC_ALERT_THRESHOLD=500
TREASURY_NOTIFICATION_EMAIL=treasury@harvesta.app
TREASURY_POLL_INTERVAL_MS=300000
TREASURY_DAILY_SUMMARY_CRON=0 8 * * *

# ─── Compliance Report Generator ──────────────────────────────────────────────
# Scheduled export for carbon registry compliance (Verra, Gold Standard, CAR, etc.)
# Generate CSV/JSON reports for regulators and auditors
COMPLIANCE_EXPORT_ENABLED=false
COMPLIANCE_EXPORT_CRON=0 2 * * *
COMPLIANCE_EXPORT_TYPE=carbon-credits
COMPLIANCE_EXPORT_FORMAT=csv
COMPLIANCE_EXPORT_REGISTRY=verra
COMPLIANCE_EXPORT_OUTPUT_PATH=./exports/compliance
COMPLIANCE_EXPORT_WEBHOOK_URL=
COMPLIANCE_EXPORT_EMAIL_RECIPIENTS=
COMPLIANCE_EXPORT_RETENTION_DAYS=90

# ─── Sentry (server-side error tracking) ──────────────────────────────────────
# Leave SENTRY_DSN blank to disable error tracking entirely — the integration
# no-ops, which is the expected setup for local development and CI.
# Find the DSN under Project Settings → Client Keys (DSN) in Sentry.
SENTRY_DSN=
# Environment name events are tagged with (defaults to NODE_ENV).
SENTRY_ENVIRONMENT=production
# Version events are attributed to, e.g. a git SHA. Optional.
SENTRY_RELEASE=
# Performance-trace sampling, 0..1. Errors are always captured regardless.
# Invalid values fall back to 0.
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Prometheus Metrics ───────────────────────────────────────────────────────
# Enable Prometheus metrics endpoint (default: false)
PROMETHEUS_METRICS_ENABLED=false
# Port for Prometheus metrics endpoint (default: 9090)
PROMETHEUS_METRICS_PORT=9090
# Path for metrics endpoint (default: /metrics)
PROMETHEUS_METRICS_PATH=/metrics
# Comma-separated list of IPs allowed to scrape metrics (leave empty for all)
PROMETHEUS_METRICS_ALLOWED_IPS=

# ─── Grafana Dashboards ───────────────────────────────────────────────────────
# Grafana API URL (for provisioning dashboards dynamically)
GRAFANA_API_URL=
# Grafana API token (needs Admin/Editor permissions)
GRAFANA_API_TOKEN=
# Grafana organization ID (default: 1)
GRAFANA_ORG_ID=1
# Grafana data source UID (optional, auto-detected if empty)
GRAFANA_DATASOURCE_UID=
# ─── Database (Read Replicas) ───────────────────────────────────────────────
# Primary database URL for writes. Required for production.
DATABASE_URL=postgres://user:password@localhost:5432/harvesta
# Comma-separated read replica connection strings used for analytics queries.
# Read-only queries are routed to replicas to avoid blocking production writes.
DATABASE_READ_REPLICA_URLS=

# ─── Centralized Logging Aggregation (ELK Stack) ──────────────────────────────
# Ingest host and port for Logstash TCP/HTTP JSON listener
LOGSTASH_HOST=localhost
LOGSTASH_PORT=50000
ELASTICSEARCH_URL=http://localhost:9200
KIBANA_URL=http://localhost:5601

