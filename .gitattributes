# Normalize line endings to LF across all operating systems to prevent CRLF vs LF merge conflicts
* text=auto eol=lf

# Source Code Files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Lockfiles - treat as binary to prevent conflict marker corruption
pnpm-lock.yaml merge=binary
package-lock.json merge=binary
yarn.lock merge=binary
Cargo.lock merge=binary

# Binary / Media Assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.wasm binary
