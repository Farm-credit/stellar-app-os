// Prisma schema for the Stellar Farm Credit application.
//
// NOTE: This schema documents the data model in Prisma format per the
// sponsor-map feature request. The production app uses raw SQL migrations
// under db/migrations/ with the `pg` driver (see lib/db/client.ts).
// To keep both in sync, mirror any model change here into a new SQL
// migration file (e.g. db/migrations/NNN_description.sql).
//
// Usage (if you later switch the app to Prisma ORM):
//   npx prisma generate
//   npx prisma migrate dev --name <description>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PlantingLocation ─────────────────────────────────────────────────────────
//
// Browseable, filterable tree-planting sites displayed on the sponsor map.
//
// Required environment for this model:
//   DATABASE_URL — standard PostgreSQL connection string

model PlantingLocation {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(200)
  description       String    @db.Text
  latitude          Float     @db.DoublePrecision
  longitude         Float     @db.DoublePrecision
  region            String    @db.VarChar(100) // e.g. "North America", "Sub-Saharan Africa"
  climate           String    @db.VarChar(50)  // e.g. "Tropical", "Arid", "Temperate"
  species           String[]                     // PostgreSQL TEXT[] — slugs matching species_catalogue.slug
  availableCapacity Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Optional: if you later relate this to existing DB tables, uncomment:
  // trees             Tree[]

  @@index([region])
  @@index([climate])
  @@index([latitude, longitude])
  @@map("planting_locations")
}

// Carbon methodology library (migration 025). Reference catalogue of calculation
// methodologies; seeded from data/carbon-methodologies/*.json.
model CarbonMethodology {
  slug             String   @id
  code             String
  name             String
  category         String   // reforestation | soil_sequestration | renewable_energy | methane_reduction | energy_efficiency
  standard         String
  version          String?
  description      String   @db.Text
  formula          String   @db.Text
  parameters       Json     @default("[]")
  applicability    String[]
  sourceRef        String   @map("source_ref") @db.Text
  metadataVerified Boolean  @default(false) @map("metadata_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("carbon_methodologies")
  @@index([category])
  @@index([standard])
}

// ── ProjectRiskScore ────────────────────────────────────────────────────────
//
// Buyer risk scores for carbon credit projects (Issue #1294).
// Calculated from verifier reputation, methodology strength, regional stability,
// and farmer track record. Persisted for auditability and caching.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model ProjectRiskScore {
  id                          String   @id @default(cuid())
  projectId                   String   @unique
  overallScore                Int      // 0-100
  riskRating                  String   // 'Low' | 'Medium' | 'High'
  verifierReputationScore     Int      // 0-100
  methodologyStrengthScore    Int      // 0-100
  regionalStabilityScore      Int      // 0-100
  farmerTrackRecordScore      Int      // 0-100
  
  // Data gap documentation (for transparency)
  dataGaps                    String[]
  
  // Metadata
  calculatedAt                DateTime @default(now()) @map("calculated_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([riskRating])
  @@index([updatedAt])
  @@map("project_risk_scores")
}

// ── Auction ─────────────────────────────────────────────────────────────────
//
// Competitive bidding mechanism allowing farmers to auction carbon credits
// to multiple buyers. Buyers place bids; the highest bidder wins at auction
// close, providing transparent price discovery.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model Auction {
  id              String    @id @default(cuid())
  farmerId        String    @map("farmer_id")
  projectId       String    @map("project_id")
  creditAmount    Int       @map("credit_amount")   // number of carbon credits auctioned
  reservePrice    Decimal   @map("reserve_price") @db.Decimal(18, 2) // minimum acceptable price per credit
  currency        String    @default("USD") @db.VarChar(10)
  status          String    @default("open") @db.VarChar(20) // 'open' | 'closed' | 'settled' | 'cancelled'
  startsAt        DateTime  @map("starts_at") @default(now())
  endsAt          DateTime  @map("ends_at")
  winningBidId    String?   @unique @map("winning_bid_id")
  winningBid      Bid?      @relation("AuctionWinningBid", fields: [winningBidId], references: [id])
  bids            Bid[]     @relation("AuctionBids")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([farmerId])
  @@index([projectId])
  @@index([status])
  @@index([endsAt])
  @@map("auctions")
}

// ── Bid ─────────────────────────────────────────────────────────────────────
//
// A single competitive bid placed by a buyer on an auction. The highest valid
// bid at auction close wins, subject to the auction's reserve price.
//
// Schema is for documentation; production uses raw SQL migrations (see note above).
model Bid {
  id          String    @id @default(cuid())
  auctionId   String    @map("auction_id")
  auction     Auction   @relation("AuctionBids", fields: [auctionId], references: [id])
  buyerId     String    @map("buyer_id")
  pricePerCredit Decimal @map("price_per_credit") @db.Decimal(18, 2)
  creditAmount   Int    @map("credit_amount")
  totalAmount    Decimal @map("total_amount") @db.Decimal(18, 2)
  status      String    @default("active") @db.VarChar(20) // 'active' | 'outbid' | 'won' | 'withdrawn'
  placedAt    DateTime  @default(now()) @map("placed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  wonAuction  Auction?  @relation("AuctionWinningBid")

  @@index([auctionId])
  @@index([buyerId])
  @@index([status])
  @@index([pricePerCredit])
  @@map("bids")
}
